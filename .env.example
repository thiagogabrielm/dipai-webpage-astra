# Canonical site origin for the static build. Set to the final Netlify/custom domain.
SITE_URL=https://dipai.no
# Set to disabled for staging builds outside Netlify. Netlify previews are excluded automatically.
# SITE_INDEXING=disabled
# Mail delivery stays disabled until configured in Netlify's runtime environment.
ENQUIRY_PROVIDER=disabled
RESEND_API_KEY=
ENQUIRY_FROM=
# Set to the exact production origin, without a trailing slash, when mail is enabled.
# SITE_ORIGIN=https://dipai.no
