---
import clients from '../data/clients.json';
import ClientLogo from './ClientLogo.astro';
import MotionControl from './MotionControl.astro';
interface Props {
  ribbon?: boolean;
  exclude?: string[];
  linked?: boolean;
}
const { ribbon = false, exclude = [], linked = true } = Astro.props;
const gridClients = clients.filter((client) => !exclude.includes(client.name));
---

{ribbon ? (
  <section id="partners" class="partners" aria-label="Customers and partners">
    <div class="wrap partner-row">
      <p>
        Trusted by
        <br /> industry leaders
      </p>
      <div class="logo-window">
        <div class="logo-track">
          <div class="logo-set">
            {clients
              .filter((c) => c.ribbon !== false)
              .map((client) => (
                <ClientLogo client={client} />
              ))}
          </div>
        </div>
      </div>
      <MotionControl control="ribbon" subject="logos" class="ribbon-pause" />
    </div>
  </section>
) : (
  <ul class="demo-client-grid" role="list">
    {gridClients.map((client) => (
      <li>
        {linked ? (
          <a
            class="client-link"
            href={client.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${client.name} website (opens in a new tab)`}
          >
            <ClientLogo client={client} linked={false} />
          </a>
        ) : (
          <ClientLogo client={client} linked={false} />
        )}
      </li>
    ))}
  </ul>
)}
