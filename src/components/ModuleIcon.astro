---
interface Props {
  icon: string | null;
}
const { icon } = Astro.props;
---

{icon ? (
  <span
    class="module-icon"
    aria-hidden="true"
    style={`--module-icon: url('/assets/${icon}')`}
  ></span>
) : (
  <svg
    class="module-icon"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    viewBox="0 0 24 24"
  >
    <path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z" />
  </svg>
)}
