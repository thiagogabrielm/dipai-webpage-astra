---
interface Props {
  subject: string;
  control: 'ribbon' | 'quote' | 'journey' | 'dashboard';
  class?: string;
}
const { subject, control, class: className } = Astro.props;
---

<button
  class:list={['motion-control', className]}
  {...{ [`data-${control}-pause`]: true }}
  data-motion-subject={subject}
  type="button"
  aria-label={`Pause ${subject}`}
  aria-pressed="false"
  title={`Pause ${subject}`}
  hidden
>
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20">
    <path d="M7 5v10M13 5v10" data-pause-icon></path>
    <path d="m7 4 9 6-9 6Z" data-play-icon></path>
  </svg>
</button>
