---
import { themeSwitching } from '../data/site-config.js';
---

<dialog class="cookie-settings" id="cookie-settings" aria-labelledby="cookie-settings-title">
  <form method="dialog">
    <button class="cookie-close" aria-label="Close cookie settings" type="submit">
      ×
    </button>
  </form>
  <h2 id="cookie-settings-title">Cookie settings</h2>
  <p>This website does not use analytics or advertising cookies.</p>
  {themeSwitching && (
    <div class="cookie-setting">
      <h3>Colour preference</h3>
      <p>
        When you choose light or dark mode, we save your choice in this browser. It stays here until
        you clear it. You can return to the default dark theme at any time.
      </p>
      <button class="button secondary" type="button" data-theme-reset>
        Use default theme
      </button>
      <p class="cookie-status" role="status" data-theme-status></p>
    </div>
  )}
  <div class="cookie-setting">
    <h3>Analytics</h3>
    <p>
      Netlify Web Analytics uses server logs to report website traffic, without analytics cookies or
      browser tracking scripts. This website does not load advertising tools.
    </p>
  </div>
  <a class="text-button" href="/privacy-policy/#cookies">
    About browser storage ›
  </a>
</dialog>
<script>
  import '../scripts/cookie-settings.js';
</script>
