<section class="fleet section" id="fleet">
  <div class="wrap theme-section-content">
    <div class="fleet-layout">
      <div class="globe-panel">
        <canvas
          aria-label="Interactive fleet globe. Drag to rotate or use the region buttons below."
          id="fleet-globe"
          role="img"
        ></canvas>
        <p class="globe-hint">DRAG TO EXPLORE</p>
      </div>
      <div class="fleet-copy">
        <h2>Better together</h2>
        <div class="fleet-numbers">
          <div>
            <strong>
              250<span>+</span>
            </strong>
            <span>vessels connected</span>
          </div>
          <div>
            <strong>6</strong>
            <span>continents</span>
          </div>
        </div>
        <p>
          Join a growing community of vessel operators sharing experience, shaping better solutions,
          and turning data into meaningful improvements.
        </p>
        <div aria-label="Explore fleet by continent" class="region-buttons">
          <button aria-pressed="true" data-region="europe">
            Europe
          </button>
          <button aria-pressed="false" data-region="africa">
            Africa
          </button>
          <button aria-pressed="false" data-region="asia">
            Asia
          </button>
          <button aria-pressed="false" data-region="oceania">
            Oceania
          </button>
          <button aria-pressed="false" data-region="americas">
            Americas
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
