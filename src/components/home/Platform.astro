---
import products from '../../data/platform.js';
import { platformVisuals } from '../../scripts/platform-visuals.js';

const tabLabels = [
  'Evaluate & improve operations',
  'Reduce fuel & emissions',
  'Make maintenance smarter',
  'Quantify and measure your SEEMP',
  'Accurate MRV & ETS reporting',
];
// The narrow-screen cards render every chart at once, so SVG ids get a per-card prefix.
const moduleVisual = (index: number) =>
  platformVisuals[index].replaceAll('mrv-mask-', `mrv-mask-m${index}-`);
---

<section class="products section" data-product-border-orbit="" id="platform">
  <div class="wrap theme-section-content">
    <div class="section-heading">
      <h2>An independent, purpose-built platform</h2>
      <p>With the flexibility to choose the capabilities your fleet needs.</p>
    </div>
    <div class="product-layout">
      <div class="product-panel-actions">
        <a class="button demo-button" href="/book-demo/">
          Book a demo
        </a>
      </div>
      <div aria-label="Platform capabilities" class="product-tabs" role="tablist">
        {tabLabels.map((label, index) => (
          <button
            aria-controls="product-panel"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-product={index}
            id={`product-tab-${index}`}
            role="tab"
          >
            <strong>{label}</strong>
          </button>
        ))}
      </div>
      <div
        aria-labelledby="product-tab-0"
        class="product-panel"
        id="product-panel"
        role="tabpanel"
        tabindex="0"
      >
        <div class="product-panel-top">
          <span id="product-category">{products[0].category}</span>
        </div>
        <h3 id="product-title">{products[0].title}</h3>
        <p id="product-description">{products[0].description}</p>
        <div class="product-graphic">
          <div class="product-chart-label">
            <span id="product-chart-label">{products[0].chart}</span>
          </div>
          {/* Server-rendered first chart, so nothing is swapped out on load. */}
          <div class="platform-example-host" set:html={platformVisuals[0]} />
          {/* Hide the animated marks from first paint; home.js starts the motion. */}
          <script is:inline>
            document.currentScript.previousElementSibling.firstElementChild?.classList.add(
              'is-waiting',
            );
          </script>
        </div>
      </div>
    </div>
    {/* Narrow screens: a swipeable strip of capabilities over one card per module. */}
    <div class="module-stack" data-module-stack>
      <div aria-label="Platform capabilities" class="module-strip" role="navigation">
        <div class="module-strip-track" data-module-strip>
          {tabLabels.map((label, index) => (
            <a
              aria-current={index === 0 ? 'true' : undefined}
              data-module-link={index}
              href={`#platform-module-${index}`}
            >
              <strong>{label}</strong>
            </a>
          ))}
        </div>
      </div>
      {products.map((product, index) => (
        <article
          aria-labelledby={`platform-module-title-${index}`}
          class="product-panel platform-module"
          data-module={index}
          id={`platform-module-${index}`}
        >
          <div class="product-panel-top">
            <span>{product.category}</span>
          </div>
          <h3 id={`platform-module-title-${index}`}>{product.title}</h3>
          <p>{product.description}</p>
          <div class="product-graphic">
            <div class="product-chart-label">
              <span>{product.chart}</span>
            </div>
            <div class="platform-example-host" set:html={moduleVisual(index)} />
          </div>
        </article>
      ))}
      {/* Hide the animated marks from first paint; home.js arms each card's motion. */}
      <script is:inline>
        document
          .querySelectorAll('[data-module-stack] .platform-example[data-motion]')
          .forEach((example) => example.classList.add('is-waiting'));
      </script>
    </div>
  </div>
</section>
