---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMember from '../components/TeamMember.astro';
import team from '../data/team.json';
import CTA from '../components/CTA.astro';

// Leadership are the people with direct contact details; everyone else is engineering.
const leadership = team.team.filter((member) => member.email);
const engineering = team.team.filter((member) => !member.email);
---

<BaseLayout
  title="Team"
  description="Meet the people behind Dipai: our software engineering team, leadership and board."
  bodyClass="team-page"
  active="team"
>
  <section aria-labelledby="team-page-title" class="team-intro wrap">
    <div class="team-intro-copy">
      <div>
        <h1 id="team-page-title">
          The people
          <br />
          behind Dipai.
        </h1>
      </div>
      <div class="team-intro-description">
        <p>{team.introduction}</p>
        <p class="team-origin">
          Dipai grew out of PhD research at NTNU in Ålesund, one of Norway’s leading maritime hubs,
          and was founded in 2021.
        </p>
        <div class="team-jump-links">
          <a class="text-button" href="#team">
            Leadership <span aria-hidden="true">↓</span>
          </a>
          <a class="text-button" href="#engineering">
            Engineering <span aria-hidden="true">↓</span>
          </a>
          <a class="text-button" href="#board">
            Board <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  <section aria-labelledby="team-heading" class="team-section wrap" id="team">
    <div class="team-section-heading">
      <h2 id="team-heading">Leadership</h2>
      <p>Direct lines to the people running Dipai.</p>
    </div>
    <ul class="team-grid team-grid--three team-grid--lead" role="list">
      {leadership.map((member) => (
        <TeamMember member={member} eager />
      ))}
    </ul>
  </section>
  <section
    aria-labelledby="engineering-heading"
    class="team-section team-section--follow wrap"
    id="engineering"
  >
    <div class="team-section-heading">
      <h2 id="engineering-heading">Engineering &amp; data science</h2>
      <p>
        The people turning vessel data <br />
        into useful insights.
      </p>
    </div>
    <ul class="team-grid team-grid--three team-grid--eng" role="list">
      {engineering.map((member) => (
        <TeamMember member={member} />
      ))}
    </ul>
  </section>
  <section aria-labelledby="board-heading" class="team-board-section" id="board">
    <div class="wrap">
      <div class="team-section-heading">
        <h2 id="board-heading">Our board</h2>
        <p>
          Experience across maritime technology, <br />
          business development and finance.
        </p>
      </div>
      <ul class="team-grid team-board-grid" role="list">
        {team.board.map((member) => (
          <TeamMember member={member} board />
        ))}
      </ul>
    </div>
  </section>
  <CTA
    title="Let’s talk about your fleet."
    description="See the platform with your vessel types and the data you already collect."
  >
    <a class="button button-outline" href="/contact/">
      Contact us <span aria-hidden="true">›</span>
    </a>
  </CTA>
</BaseLayout>
