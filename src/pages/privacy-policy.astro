---
import { themeSwitching } from '../data/site-config.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import policy from '../data/privacy-policy.json';
---

<BaseLayout
  title="Privacy policy"
  description="About the processing of personal data at Dipai AS."
  bodyClass="privacy-page"
>
  <header class="wrap privacy-intro">
    <h1>Privacy policy</h1>
    <p>About the processing of personal data at Dipai AS.</p>
  </header>
  <div class="wrap privacy-layout">
    <aside>
      <nav class="privacy-contents" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        {policy.sections.map((s) => (
          <a href={`#${s.id}`}>{s.title}</a>
        ))}
        <a href="#cookies">8. Cookies and browser storage</a>
      </nav>
    </aside>
    <article class="privacy-copy">
      <div class="privacy-controller" set:html={policy.intro} />
      {policy.sections.map((s) => (
        <section id={s.id} aria-labelledby={`${s.id}-title`}>
          <h2 id={`${s.id}-title`}>{s.title}</h2>
          <Fragment set:html={s.html} />
        </section>
      ))}
      <section id="cookies" aria-labelledby="cookies-title">
        <h2 id="cookies-title">8. Cookies and browser storage</h2>
        <p>
          This website does not set analytics or advertising cookies and does not load browser-based
          analytics or advertising scripts. Fonts and images are served with the website, without
          third-party font or embedded social media services.
        </p>
        <p>
          Netlify Web Analytics derives website traffic statistics from our hosting provider’s
          server logs, including page requests, referring websites and approximate visitor
          locations. IP addresses are used to count unique visitors. These statistics help us
          understand which pages are useful and identify missing pages. Learn more about{' '}
          <a href="https://docs.netlify.com/manage/monitoring/web-analytics/how-web-analytics-works/">
            how Netlify Web Analytics works
          </a>
          .
        </p>
        {themeSwitching && (
          <>
            <p>
              If you choose light or dark mode, the website saves that choice in your browser’s
              local storage under <code>dipai-color-theme</code>. It is used only to remember your
              colour preference and stays until you clear it. It is not sent to our servers.
            </p>
            <p>
              Open{' '}
              <a href="#cookies" data-cookie-settings>
                Cookie settings
              </a>{' '}
              and select “Use default theme” to remove the saved preference, or clear it through
              your browser’s site-data settings. Without a saved preference, the site uses dark
              mode.
            </p>
          </>
        )}
        <p>
          Links to other websites open services with their own privacy and cookie policies.
          Information you submit through our contact and demo forms is handled as described above.
        </p>
      </section>
    </article>
  </div>
</BaseLayout>
