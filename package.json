{
  "name": "dipai-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 48767",
    "build": "astro check && astro build && node scripts/finalize-build.mjs && node scripts/validate-build.mjs && node scripts/validate-seo.mjs",
    "preview": "node server/serve.mjs",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "prebuild": "node scripts/prepare-media.mjs",
    "predev": "node scripts/prepare-media.mjs",
    "precheck": "node scripts/prepare-media.mjs",
    "format": "prettier --write src server netlify tests scripts astro.config.mjs playwright.config.ts",
    "format:check": "prettier --check src server netlify tests scripts astro.config.mjs playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.3.8",
    "d3-geo": "^3.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "parse5": "^8.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
